{
  "$defs": {
    "Acquisition": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "type": "string"
        },
        "retrieved_at": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "url",
        "retrieved_at"
      ],
      "type": "object"
    },
    "Assertion": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "object_id": {
          "type": "string"
        },
        "observation_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "predicate": {
          "type": "string"
        },
        "review": {
          "$ref": "#/$defs/ReviewState"
        },
        "subject_id": {
          "type": "string"
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid_to": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "subject_id",
        "predicate",
        "object_id",
        "observation_ids",
        "confidence",
        "review"
      ],
      "type": "object"
    },
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "identifiers": {
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/EntityKind"
        },
        "merged_into": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "identifiers"
      ],
      "type": "object"
    },
    "EntityKind": {
      "enum": [
        "person",
        "organisation",
        "group",
        "account",
        "place",
        "digital_identifier"
      ],
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "acquisitions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Acquisition"
          },
          "type": "array"
        },
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "extraction_status": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "imported_at": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "origin_group": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "sha256",
        "bytes",
        "media_type",
        "origin_group",
        "imported_at",
        "extraction_status"
      ],
      "type": "object"
    },
    "FrozenGraph": {
      "additionalProperties": false,
      "properties": {
        "assertion_reviews": {
          "$ref": "#/$defs/GraphReviewCounts"
        },
        "assertions": {
          "items": {
            "$ref": "#/$defs/Assertion"
          },
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/GraphEdge"
          },
          "type": "array"
        },
        "entities": {
          "items": {
            "$ref": "#/$defs/Entity"
          },
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "type": "array"
        },
        "fingerprints": {
          "items": {
            "$ref": "#/$defs/GraphFingerprint"
          },
          "type": "array"
        },
        "nodes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "type": "array"
        }
      },
      "required": [
        "assertion_reviews",
        "nodes",
        "edges",
        "fingerprints",
        "entities",
        "assertions",
        "observations",
        "evidence"
      ],
      "type": "object"
    },
    "GraphEdge": {
      "additionalProperties": false,
      "properties": {
        "assertion_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "source_id": {
          "type": "string"
        },
        "target_id": {
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "target_id",
        "assertion_ids"
      ],
      "type": "object"
    },
    "GraphFingerprint": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "sha256"
      ],
      "type": "object"
    },
    "GraphOutcome": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "hops": {
              "items": {
                "$ref": "#/$defs/GraphEdge"
              },
              "type": "array"
            },
            "nodes": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "state": {
              "const": "path",
              "type": "string"
            }
          },
          "required": [
            "state",
            "nodes",
            "hops"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "unreachable",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "GraphReviewCounts": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "deferred": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "pending": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "rejected": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "accepted",
        "pending",
        "rejected",
        "deferred"
      ],
      "type": "object"
    },
    "Identifier": {
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "value"
      ],
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "$ref": "#/$defs/SourceAnchor"
        },
        "entity_id": {
          "type": "string"
        },
        "extraction_quality": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "field": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "review": {
          "$ref": "#/$defs/ReviewState"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "entity_id",
        "field",
        "value",
        "anchor",
        "review"
      ],
      "type": "object"
    },
    "ReviewState": {
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "deferred"
      ],
      "type": "string"
    },
    "SourceAnchor": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "evidence_id": {
              "type": "string"
            },
            "kind": {
              "const": "text",
              "type": "string"
            },
            "line_end": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "line_start": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "evidence_id",
            "line_start",
            "line_end"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "evidence_id": {
              "type": "string"
            },
            "kind": {
              "const": "page",
              "type": "string"
            },
            "page": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "region": {
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": [
                "array",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "evidence_id",
            "page"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "column": {
              "type": "string"
            },
            "evidence_id": {
              "type": "string"
            },
            "kind": {
              "const": "cell",
              "type": "string"
            },
            "row": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "sheet": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "evidence_id",
            "sheet",
            "row",
            "column"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "evidence_id": {
              "type": "string"
            },
            "kind": {
              "const": "message",
              "type": "string"
            },
            "message_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "evidence_id",
            "message_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "evidence_id": {
              "type": "string"
            },
            "kind": {
              "const": "capture",
              "type": "string"
            },
            "selector": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "evidence_id",
            "selector"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "capture_nonce": {
      "type": "string"
    },
    "captured_revision": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "engine": {
      "type": "string"
    },
    "engine_version": {
      "type": "string"
    },
    "frozen": {
      "$ref": "#/$defs/FrozenGraph"
    },
    "host_attempt_lease": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "limitation": {
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/GraphOutcome"
    },
    "policy": {
      "type": "string"
    },
    "published_revision": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "queued_revision": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "recipe": {
      "type": "string"
    },
    "request_json": {
      "type": "string"
    },
    "request_key": {
      "type": "string"
    },
    "request_sha256": {
      "type": "string"
    },
    "requested_revision": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "result_json": {
      "type": "string"
    },
    "result_sha256": {
      "type": "string"
    },
    "runtime_manifest_sha256": {
      "type": "string"
    },
    "schema_version": {
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    },
    "snapshot_sha256": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "target_id": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "job_id",
    "request_key",
    "attempt",
    "host_attempt_lease",
    "requested_revision",
    "queued_revision",
    "recipe",
    "policy",
    "engine",
    "engine_version",
    "runtime_manifest_sha256",
    "source_id",
    "target_id",
    "captured_revision",
    "published_revision",
    "capture_nonce",
    "snapshot_sha256",
    "request_sha256",
    "result_sha256",
    "request_json",
    "result_json",
    "frozen",
    "outcome",
    "limitation"
  ],
  "title": "GraphAnalysisRecord",
  "type": "object"
}