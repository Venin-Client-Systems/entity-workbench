          "$ref": "#/$defs/TransactionBalanceState"
        },
        "id": {
          "type": "string"
        },
        "version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version",
        "balance"
      ],
      "type": "object"
    },
    "TransactionBalanceState": {
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "This row has no retained available balance; it can still contribute movement.",
          "properties": {
            "state": {
              "const": "no_balance",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "This is the first retained balance for its source/account/currency group.",
          "properties": {
            "state": {
              "const": "no_prior_balance",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "contributing_row_count": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "difference": {
              "type": "string"
            },
            "previous_id": {
              "type": "string"
            },
            "previous_version": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "reconciled": {
              "type": "boolean"
            },
            "state": {
              "const": "checked",
              "type": "string"
            }
          },
          "required": [
            "state",
            "previous_id",
            "previous_version",
            "contributing_row_count",
            "difference",
            "reconciled"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "rows": {
      "description": "Exact requested set in request order. No partial successful result.",
      "items": {
        "$ref": "#/$defs/TransactionBalanceRow"
      },
      "type": "array"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "workspace_revision": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "workspace_revision",
    "rows"
  ],
  "title": "TransactionBalances",
  "type": "object"
}