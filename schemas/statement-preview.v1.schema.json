{
  "$defs": {
    "ReviewState": {
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "deferred"
      ],
      "type": "string"
    },
    "SourceAnchor": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "evidence_id": {
              "type": "string"
            },
            "kind": {
              "const": "text",
              "type": "string"
            },
            "line_end": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "line_start": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "evidence_id",
            "line_start",
            "line_end"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "evidence_id": {
              "type": "string"
            },
            "kind": {
              "const": "page",
              "type": "string"
            },
            "page": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "region": {
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": [
                "array",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "evidence_id",
            "page"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "column": {
              "type": "string"
            },
            "evidence_id": {
              "type": "string"
            },
            "kind": {
              "const": "cell",
              "type": "string"
            },
            "row": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "sheet": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "evidence_id",
            "sheet",
            "row",
            "column"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "evidence_id": {
              "type": "string"
            },
            "kind": {
              "const": "message",
              "type": "string"
            },
            "message_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "evidence_id",
            "message_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "evidence_id": {
              "type": "string"
            },
            "kind": {
              "const": "capture",
              "type": "string"
            },
            "selector": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "evidence_id",
            "selector"
          ],
          "type": "object"
        }
      ]
    },
    "StatementIssue": {
      "properties": {
        "message": {
          "type": "string"
        },
        "source_row": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "source_row",
        "message"
      ],
      "type": "object"
    },
    "StatementPreviewRow": {
      "properties": {
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "original_amounts": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "type": "array"
        },
        "source_row": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "transaction": {
          "anyOf": [
            {
              "$ref": "#/$defs/Transaction"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_row",
        "original_amounts"
      ],
      "type": "object"
    },
    "Transaction": {
      "additionalProperties": false,
      "properties": {
        "account": {
          "type": "string"
        },
        "amount": {
          "type": "string"
        },
        "anchor": {
          "$ref": "#/$defs/SourceAnchor"
        },
        "balance": {
          "type": [
            "string",
            "null"
          ]
        },
        "currency": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "duplicate_candidates": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "merchant": {
          "type": [
            "string",
            "null"
          ]
        },
        "posting_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "review": {
          "$ref": "#/$defs/ReviewState"
        },
        "transfer_peer": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "account",
        "date",
        "description",
        "amount",
        "currency",
        "anchor",
        "review",
        "duplicate_candidates",
        "version"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "already_imported": {
      "type": "boolean"
    },
    "balance_mismatches": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "invalid_rows": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/StatementIssue"
      },
      "type": "array"
    },
    "issues_truncated": {
      "type": "boolean"
    },
    "preview_token": {
      "type": "string"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/StatementPreviewRow"
      },
      "type": "array"
    },
    "rows_truncated": {
      "type": "boolean"
    },
    "sha256": {
      "type": "string"
    },
    "total_rows": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "valid_rows": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "workspace_revision": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "workspace_revision",
    "sha256",
    "preview_token",
    "already_imported",
    "total_rows",
    "valid_rows",
    "invalid_rows",
    "balance_mismatches",
    "rows",
    "issues",
    "rows_truncated",
    "issues_truncated"
  ],
  "title": "StatementPreview",
  "type": "object"
}