{
  "$defs": {
    "LiteralMatching": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/LiteralSearchAlgorithm"
        },
        "unicode_version": {
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "algorithm",
        "unicode_version"
      ],
      "type": "object"
    },
    "LiteralSearchAlgorithm": {
      "enum": [
        "unicode_default_lowercase_literal_v1"
      ],
      "type": "string"
    },
    "ReviewState": {
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "deferred"
      ],
      "type": "string"
    },
    "SourceAnchor": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "evidence_id": {
              "type": "string"
            },
            "kind": {
              "const": "text",
              "type": "string"
            },
            "line_end": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "line_start": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "evidence_id",
            "line_start",
            "line_end"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "evidence_id": {
              "type": "string"
            },
            "kind": {
              "const": "page",
              "type": "string"
            },
            "page": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "region": {
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": [
                "array",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "evidence_id",
            "page"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "column": {
              "type": "string"
            },
            "evidence_id": {
              "type": "string"
            },
            "kind": {
              "const": "cell",
              "type": "string"
            },
            "row": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "sheet": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "evidence_id",
            "sheet",
            "row",
            "column"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "evidence_id": {
              "type": "string"
            },
            "kind": {
              "const": "message",
              "type": "string"
            },
            "message_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "evidence_id",
            "message_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "evidence_id": {
              "type": "string"
            },
            "kind": {
              "const": "capture",
              "type": "string"
            },
            "selector": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "evidence_id",
            "selector"
          ],
          "type": "object"
        }
      ]
    },
    "Transaction": {
      "additionalProperties": false,
      "properties": {
        "account": {
          "type": "string"
        },
        "amount": {
          "type": "string"
        },
        "anchor": {
          "$ref": "#/$defs/SourceAnchor"
        },
        "balance": {
          "type": [
            "string",
            "null"
          ]
        },
        "currency": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "duplicate_candidates": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "merchant": {
          "type": [
            "string",
            "null"
          ]
        },
        "posting_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "review": {
          "$ref": "#/$defs/ReviewState"
        },
        "transfer_peer": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "account",
        "date",
        "description",
        "amount",
        "currency",
        "anchor",
        "review",
        "duplicate_candidates",
        "version"
      ],
      "type": "object"
    },
    "TransactionPage": {
      "additionalProperties": false,
      "properties": {
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "query_sha256": {
          "type": "string"
        },
        "review_counts": {
          "$ref": "#/$defs/TransactionReviewCounts"
        },
        "rows": {
          "description": "Exact canonical rows, including original decimal strings and source anchors.",
          "items": {
            "$ref": "#/$defs/Transaction"
          },
          "type": "array"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "scope_count": {
          "description": "Date/account/currency scope, before the optional review-state selection.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "selected_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "workspace_revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "workspace_revision",
        "query_sha256",
        "scope_count",
        "review_counts",
        "selected_count",
        "rows"
      ],
      "type": "object"
    },
    "TransactionReviewCounts": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "deferred": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "pending": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "rejected": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "accepted",
        "pending",
        "rejected",
        "deferred"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "matching": {
      "$ref": "#/$defs/LiteralMatching"
    },
    "page": {
      "$ref": "#/$defs/TransactionPage",
      "description": "Other-account scope before review selection; selected_count is accepted rows."
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "target_id": {
      "type": "string"
    },
    "target_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "target_id",
    "target_version",
    "matching",
    "page"
  ],
  "title": "TransferCandidatesPage",
  "type": "object"
}