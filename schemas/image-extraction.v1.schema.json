{
  "$defs": {
    "DecodeFailure": {
      "enum": [
        "unsupported_format",
        "multiple_images",
        "malformed_image",
        "decoder_warning",
        "pixel_limit",
        "container_limit"
      ],
      "type": "string"
    },
    "DecodeLimitation": {
      "enum": [
        "exif_orientation_not_applied",
        "embedded_previews_excluded",
        "metadata_not_extracted",
        "color_converted_to_gray",
        "no_document_page_mapping"
      ],
      "type": "string"
    },
    "DecodeStatus": {
      "enum": [
        "decoded",
        "unsupported",
        "failed",
        "quota_exhausted"
      ],
      "type": "string"
    },
    "ImageDecodeResult": {
      "additionalProperties": false,
      "properties": {
        "decoder": {
          "type": "string"
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecodeFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "java_runtime": {
          "type": "string"
        },
        "job_id": {
          "type": "string"
        },
        "limitations": {
          "items": {
            "$ref": "#/$defs/DecodeLimitation"
          },
          "type": "array"
        },
        "media_type": {
          "type": "string"
        },
        "original_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "original_sha256": {
          "type": "string"
        },
        "protocol_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "raster": {
          "anyOf": [
            {
              "$ref": "#/$defs/RasterBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/DecodeStatus"
        }
      },
      "required": [
        "protocol_version",
        "job_id",
        "original_sha256",
        "original_bytes",
        "decoder",
        "java_runtime",
        "media_type",
        "status",
        "limitations"
      ],
      "type": "object"
    },
    "ImageExtractionResult": {
      "additionalProperties": false,
      "properties": {
        "decoder": {
          "$ref": "#/$defs/ImageDecodeResult"
        },
        "raster_retained": {
          "description": "Always false in v1: the raster was validated in memory and then discarded.",
          "type": "boolean"
        },
        "recognition": {
          "anyOf": [
            {
              "$ref": "#/$defs/OcrResult"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "decoder",
        "raster_retained"
      ],
      "type": "object"
    },
    "ImageOcrInput": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "evidence_id": {
              "type": "string"
            },
            "operation": {
              "const": "image_ocr",
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          },
          "required": [
            "operation",
            "evidence_id",
            "sha256",
            "bytes"
          ],
          "type": "object"
        }
      ]
    },
    "OcrLimitation": {
      "enum": [
        "unreviewed_recognition",
        "no_word_regions",
        "no_original_document_mapping"
      ],
      "type": "string"
    },
    "OcrResult": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "type": "string"
        },
        "height": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "job_id": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "limitations": {
          "items": {
            "$ref": "#/$defs/OcrLimitation"
          },
          "type": "array"
        },
        "model_sha256": {
          "type": "string"
        },
        "protocol_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "raster_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "raster_sha256": {
          "description": "The exact canonical PGM raster, never the original PDF or compressed image.",
          "type": "string"
        },
        "runtime_manifest_sha256": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/OcrStatus"
        },
        "text": {
          "type": "string"
        },
        "width": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "protocol_version",
        "job_id",
        "raster_sha256",
        "raster_bytes",
        "width",
        "height",
        "engine",
        "language",
        "model_sha256",
        "runtime_manifest_sha256",
        "status",
        "text",
        "limitations"
      ],
      "type": "object"
    },
    "OcrStatus": {
      "enum": [
        "recognized",
        "no_text_recognized"
      ],
      "type": "string"
    },
    "PixelMapping": {
      "enum": [
        "encoded_pixels_gray_white_alpha_v1"
      ],
      "type": "string"
    },
    "RasterBinding": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "height": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "type": "string"
        },
        "pixel_mapping": {
          "$ref": "#/$defs/PixelMapping"
        },
        "sha256": {
          "type": "string"
        },
        "source_image_index": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "width": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes",
        "width",
        "height",
        "source_image_index",
        "pixel_mapping"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An immutable, unreviewed image derivative. No pixel regions or accepted observations.",
  "properties": {
    "attempt": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "created_at": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "input": {
      "$ref": "#/$defs/ImageOcrInput"
    },
    "job_id": {
      "type": "string"
    },
    "result": {
      "$ref": "#/$defs/ImageExtractionResult"
    },
    "result_sha256": {
      "type": "string"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "id",
    "job_id",
    "attempt",
    "input",
    "created_at",
    "result_sha256",
    "result"
  ],
  "title": "ImageExtractionRecord",
  "type": "object"
}