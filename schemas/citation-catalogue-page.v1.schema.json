{
  "$defs": {
    "CitationEvidence": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "extraction_status": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "imported_at": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "origin_group": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "sha256",
        "bytes",
        "media_type",
        "origin_group",
        "imported_at",
        "extraction_status"
      ],
      "type": "object"
    },
    "CitationSummary": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "anchor": {
              "$ref": "#/$defs/SourceAnchor"
            },
            "entity_id": {
              "type": "string"
            },
            "entity_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "field": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "observation",
              "type": "string"
            },
            "review": {
              "$ref": "#/$defs/ReviewState"
            },
            "source": {
              "$ref": "#/$defs/CitationEvidence"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id",
            "entity_id",
            "field",
            "value",
            "review",
            "anchor",
            "source"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "account": {
              "type": "string"
            },
            "amount": {
              "type": "string"
            },
            "anchor": {
              "$ref": "#/$defs/SourceAnchor"
            },
            "currency": {
              "type": "string"
            },
            "date": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "transaction",
              "type": "string"
            },
            "review": {
              "$ref": "#/$defs/ReviewState"
            },
            "source": {
              "$ref": "#/$defs/CitationEvidence"
            },
            "version": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "id",
            "description",
            "amount",
            "currency",
            "date",
            "account",
            "review",
            "version",
            "anchor",
            "source"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "evidence",
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/CitationEvidence"
            }
          },
          "required": [
            "kind",
            "id",
            "source"
          ],
          "type": "object"
        }
      ]
    },
    "LiteralMatching": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/LiteralSearchAlgorithm"
        },
        "unicode_version": {
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "algorithm",
        "unicode_version"
      ],
      "type": "object"
    },
    "LiteralSearchAlgorithm": {
      "enum": [
        "unicode_default_lowercase_literal_v1"
      ],
      "type": "string"
    },
    "ReviewState": {
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "deferred"
      ],
      "type": "string"
    },
    "SourceAnchor": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "evidence_id": {
              "type": "string"
            },
            "kind": {
              "const": "text",
              "type": "string"
            },
            "line_end": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "line_start": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "evidence_id",
            "line_start",
            "line_end"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "evidence_id": {
              "type": "string"
            },
            "kind": {
              "const": "page",
              "type": "string"
            },
            "page": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "region": {
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": [
                "array",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "evidence_id",
            "page"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "column": {
              "type": "string"
            },
            "evidence_id": {
              "type": "string"
            },
            "kind": {
              "const": "cell",
              "type": "string"
            },
            "row": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "sheet": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "evidence_id",
            "sheet",
            "row",
            "column"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "evidence_id": {
              "type": "string"
            },
            "kind": {
              "const": "message",
              "type": "string"
            },
            "message_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "evidence_id",
            "message_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "evidence_id": {
              "type": "string"
            },
            "kind": {
              "const": "capture",
              "type": "string"
            },
            "selector": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "evidence_id",
            "selector"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "matching": {
      "$ref": "#/$defs/LiteralMatching"
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "query_sha256": {
      "type": "string"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/CitationSummary"
      },
      "type": "array"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "scope_count": {
      "description": "Literal-query matches after selected-ID exclusions, before pagination.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "workspace_revision": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "workspace_revision",
    "matching",
    "query_sha256",
    "scope_count",
    "rows"
  ],
  "title": "CitationCataloguePage",
  "type": "object"
}