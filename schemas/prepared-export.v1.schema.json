{
  "$defs": {
    "ExportArtifact": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "document_sha256": {
              "type": "string"
            },
            "kind": {
              "const": "docx_report",
              "type": "string"
            },
            "report_id": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "workspace_revision": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "report_id",
            "workspace_revision",
            "document_sha256",
            "bytes",
            "sha256"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "transactions",
              "type": "string"
            },
            "matching": {
              "$ref": "#/$defs/LiteralMatching"
            },
            "query_sha256": {
              "type": "string"
            },
            "request": {
              "$ref": "#/$defs/TransactionExportRequest"
            },
            "row_count": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "sha256": {
              "type": "string"
            },
            "workspace_revision": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "workspace_revision",
            "request",
            "matching",
            "query_sha256",
            "row_count",
            "bytes",
            "sha256"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "html_report",
              "type": "string"
            },
            "report_id": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "workspace_revision": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "report_id",
            "workspace_revision",
            "bytes",
            "sha256"
          ],
          "type": "object"
        }
      ]
    },
    "LiteralMatching": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/LiteralSearchAlgorithm"
        },
        "unicode_version": {
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "algorithm",
        "unicode_version"
      ],
      "type": "object"
    },
    "LiteralSearchAlgorithm": {
      "enum": [
        "unicode_default_lowercase_literal_v1"
      ],
      "type": "string"
    },
    "ReviewState": {
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "deferred"
      ],
      "type": "string"
    },
    "TransactionExportRequest": {
      "additionalProperties": false,
      "properties": {
        "filter": {
          "$ref": "#/$defs/TransactionPageFilter"
        },
        "order": {
          "$ref": "#/$defs/TransactionPageOrder"
        },
        "query": {
          "type": "string"
        }
      },
      "required": [
        "query",
        "filter",
        "order"
      ],
      "type": "object"
    },
    "TransactionPageFilter": {
      "additionalProperties": false,
      "properties": {
        "account": {
          "type": [
            "string",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "date_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "date_to": {
          "type": [
            "string",
            "null"
          ]
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewState"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "TransactionPageOrder": {
      "enum": [
        "date_ascending",
        "date_descending"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "$ref": "#/$defs/ExportArtifact"
    },
    "expires_after_seconds": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "ticket": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "ticket",
    "expires_after_seconds",
    "artifact"
  ],
  "title": "PreparedExport",
  "type": "object"
}