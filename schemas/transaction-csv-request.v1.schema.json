{
  "$defs": {
    "NonAcceptedCsvPolicy": {
      "enum": [
        "reject",
        "allow_selected"
      ],
      "type": "string"
    },
    "ReviewState": {
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "deferred"
      ],
      "type": "string"
    },
    "TransactionExportRequest": {
      "additionalProperties": false,
      "properties": {
        "filter": {
          "$ref": "#/$defs/TransactionPageFilter"
        },
        "order": {
          "$ref": "#/$defs/TransactionPageOrder"
        },
        "query": {
          "type": "string"
        }
      },
      "required": [
        "query",
        "filter",
        "order"
      ],
      "type": "object"
    },
    "TransactionPageFilter": {
      "additionalProperties": false,
      "properties": {
        "account": {
          "type": [
            "string",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "date_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "date_to": {
          "type": [
            "string",
            "null"
          ]
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewState"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "TransactionPageOrder": {
      "enum": [
        "date_ascending",
        "date_descending"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "non_accepted": {
      "$ref": "#/$defs/NonAcceptedCsvPolicy"
    },
    "selection": {
      "$ref": "#/$defs/TransactionExportRequest"
    }
  },
  "required": [
    "selection",
    "non_accepted"
  ],
  "title": "TransactionCsvRequest",
  "type": "object"
}