{
  "$defs": {
    "ParseFailure": {
      "enum": [
        "malformed_document",
        "encrypted_document",
        "archive_limits",
        "text_extraction_restricted"
      ],
      "type": "string"
    },
    "ParseLimitation": {
      "enum": [
        "no_source_anchors",
        "embedded_documents_excluded",
        "ocr_not_performed",
        "text_limit",
        "metadata_limit",
        "page_limit"
      ],
      "type": "string"
    },
    "ParseResult": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParseFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "job_id": {
          "type": "string"
        },
        "limitations": {
          "items": {
            "$ref": "#/$defs/ParseLimitation"
          },
          "type": "array"
        },
        "media_type": {
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "object"
        },
        "parser": {
          "type": "string"
        },
        "protocol_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "source_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/ParseStatus"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "protocol_version",
        "job_id",
        "content_sha256",
        "source_bytes",
        "parser",
        "media_type",
        "status",
        "text",
        "metadata",
        "limitations"
      ],
      "type": "object"
    },
    "ParseStatus": {
      "enum": [
        "complete",
        "partial",
        "unsupported",
        "failed"
      ],
      "type": "string"
    },
    "ProcessingInput": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "evidence_id": {
              "type": "string"
            },
            "operation": {
              "const": "parse_document",
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          },
          "required": [
            "operation",
            "evidence_id",
            "sha256",
            "bytes"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An immutable, unreviewed derivative. Parsing does not replace source text or accept facts.",
  "properties": {
    "attempt": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "created_at": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "input": {
      "$ref": "#/$defs/ProcessingInput"
    },
    "job_id": {
      "type": "string"
    },
    "result": {
      "$ref": "#/$defs/ParseResult"
    },
    "result_sha256": {
      "type": "string"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "id",
    "job_id",
    "attempt",
    "input",
    "created_at",
    "result_sha256",
    "result"
  ],
  "title": "ExtractionRecord",
  "type": "object"
}