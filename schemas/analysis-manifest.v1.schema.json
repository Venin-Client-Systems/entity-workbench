{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "engine": {
      "type": "string"
    },
    "engine_version": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "input_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "outputs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "workspace_revision": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "id",
    "workspace_revision",
    "engine",
    "engine_version",
    "input_ids",
    "outputs"
  ],
  "title": "AnalysisManifest",
  "type": "object"
}