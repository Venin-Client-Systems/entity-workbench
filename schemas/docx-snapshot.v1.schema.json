{
  "$defs": {
    "ReportArtifactKind": {
      "enum": [
        "report_document_json_v1",
        "report_docx_v1"
      ],
      "type": "string"
    },
    "ReportArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/ReportArtifactKind"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "sha256",
        "bytes"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "type": "string"
    },
    "document": {
      "$ref": "#/$defs/ReportArtifactRef"
    },
    "docx": {
      "$ref": "#/$defs/ReportArtifactRef"
    },
    "generator_version": {
      "type": "string"
    },
    "id": {
