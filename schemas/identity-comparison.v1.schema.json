{
  "$defs": {
    "ComparisonField": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string"
        },
        "left": {
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "type": "array"
        },
        "right": {
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "type": "array"
        },
        "signal": {
          "$ref": "#/$defs/ComparisonSignal"
        },
        "source_groups": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "field",
        "left",
        "right",
        "signal",
        "source_groups"
      ],
      "type": "object"
    },
    "ComparisonSignal": {
      "enum": [
        "insufficient_reviewed_evidence",
        "shared_reviewed_values",
        "different_reviewed_values",
        "mixed_reviewed_values"
      ],
      "type": "string"
    },
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "identifiers": {
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/EntityKind"
        },
        "merged_into": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "identifiers"
      ],
      "type": "object"
    },
    "EntityKind": {
      "enum": [
        "person",
        "organisation",
        "group",
        "account",
        "place",
        "digital_identifier"
      ],
      "type": "string"
    },
    "Identifier": {
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "value"
      ],
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "$ref": "#/$defs/SourceAnchor"
        },
        "entity_id": {
          "type": "string"
        },
        "extraction_quality": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "field": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "review": {
          "$ref": "#/$defs/ReviewState"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "entity_id",
        "field",
        "value",
        "anchor",
        "review"
      ],
      "type": "object"
    },
    "ReviewState": {
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "deferred"
      ],
      "type": "string"
    },
    "SourceAnchor": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "evidence_id": {
              "type": "string"
            },
            "kind": {
              "const": "text",
              "type": "string"
            },
            "line_end": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "line_start": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "evidence_id",
            "line_start",
            "line_end"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "evidence_id": {
              "type": "string"
            },
            "kind": {
              "const": "page",
              "type": "string"
            },
            "page": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "region": {
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": [
                "array",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "evidence_id",
            "page"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "column": {
              "type": "string"
            },
            "evidence_id": {
              "type": "string"
            },
            "kind": {
              "const": "cell",
              "type": "string"
            },
            "row": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "sheet": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "evidence_id",
            "sheet",
            "row",
            "column"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "evidence_id": {
              "type": "string"
            },
            "kind": {
              "const": "message",
              "type": "string"
            },
            "message_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "evidence_id",
            "message_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "evidence_id": {
              "type": "string"
            },
            "kind": {
              "const": "capture",
              "type": "string"
            },
            "selector": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "evidence_id",
            "selector"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "fields": {
      "items": {
        "$ref": "#/$defs/ComparisonField"
      },
      "type": "array"
    },
    "left": {
      "$ref": "#/$defs/Entity"
    },
    "right": {
      "$ref": "#/$defs/Entity"
    },
    "workspace_revision": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "workspace_revision",
    "left",
    "right",
    "fields"
  ],
  "title": "IdentityComparison",
  "type": "object"
}