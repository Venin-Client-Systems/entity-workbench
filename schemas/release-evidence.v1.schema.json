{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "release-evidence.v1.schema.json",
  "title": "Release evidence observation version 1",
  "description": "Structural contract. scripts/release_evidence.py enforces policy bindings, safe file integrity, review chronology, resource limits and qualifying platform coverage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "gate",
    "target",
    "source_revision",
    "artifact_sha256",
    "policy_sha256",
    "fixture_catalogue_sha256",
    "observed_at",
    "environment",
    "kind",
    "procedure",
    "result",
    "review",
    "attachments"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "gate": {
      "enum": [
        "integrated_workflows",
        "windows_appcontainer",
        "macos_signed_helpers",
        "all_runtime_dependencies_bundled",
        "offline_clean_install_three_targets",
        "hostile_input_and_resource_exhaustion",
        "broad_local_web_coverage",
        "recovery_and_migration_failures",
        "benchmark_16gb_target",
        "dependency_license_and_security_review",
        "signed_and_notarized_artifacts",
        "downloaded_artifact_verification"
      ]
    },
    "target": {
      "enum": [
        "windows-x86_64",
        "macos-aarch64",
        "macos-x86_64"
      ]
    },
    "source_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "artifact_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "fixture_catalogue_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "observed_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os_family",
        "os_version",
        "architecture",
        "memory_gib",
        "context"
      ],
      "properties": {
        "os_family": {
          "enum": [
            "windows",
            "macos"
          ]
        },
        "os_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"
        },
        "architecture": {
          "enum": [
            "x86_64",
            "aarch64"
          ]
        },
        "memory_gib": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "context": {
          "enum": [
            "installed",
            "clean_install",
            "hosted_ci",
            "development"
          ]
        }
      }
    },
    "kind": {
      "enum": [
        "download_verification",
        "hostile_input",
        "installed_workflow",
        "live_discovery",
        "offline_install",
        "performance",
        "recovery",
        "review",
        "runtime_inventory",
        "sandbox_probe",
        "signature_verification",
        "source_check"
      ]
    },
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "invocation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "invocation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        }
      }
    },
    "result": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "not_run"
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "role",
        "reference",
        "receipt"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "accepted",
            "rejected"
          ]
        },
        "role": {
          "enum": [
            null,
            "maintainer",
            "security-reviewer",
            "release-verifier"
          ]
        },
        "reference": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
            }
          ]
        },
        "receipt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "size",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "size": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 67108864
                },
                "sha256": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "pending"
              }
            }
          },
          "then": {
            "properties": {
              "role": {
                "type": "null"
              },
              "reference": {
                "type": "null"
              },
              "receipt": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "role": {
                "enum": [
                  "maintainer",
                  "security-reviewer",
                  "release-verifier"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
              },
              "receipt": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "size",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 67108864
                  },
                  "sha256": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "attachments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 67108864
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
