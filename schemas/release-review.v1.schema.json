{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "release-review.v1.schema.json",
  "title": "Release review receipt version 1",
  "description": "Structural contract. scripts/release_evidence.py enforces policy bindings, safe file integrity, review chronology, resource limits and qualifying platform coverage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reference",
    "evidence_id",
    "observation_sha256",
    "decision",
    "reviewer_role",
    "reviewed_at",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "observation_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision": {
      "enum": [
        "accepted",
        "rejected"
      ]
    },
    "reviewer_role": {
      "enum": [
        "maintainer",
        "security-reviewer",
        "release-verifier"
      ]
    },
    "reviewed_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  }
}
