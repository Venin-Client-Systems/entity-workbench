        "id": {
          "description": "Also the caller's stable request identity. Reuse binds the same source revision.",
          "type": "string"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "template_version": {
          "type": "string"
        },
        "workspace_revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "id",
        "workspace_revision",
        "created_at",
