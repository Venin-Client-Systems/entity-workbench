  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "document": {
      "$ref": "#/$defs/ReportDocument",
      "description": "Explicit bounded read; not part of a default workspace refresh."
    },
    "snapshot": {
      "$ref": "#/$defs/DocxSnapshotRecord"
    }
  },
  "required": [
    "snapshot",
    "document"
  ],
  "title": "DocxSnapshotInspection",
  "type": "object"
