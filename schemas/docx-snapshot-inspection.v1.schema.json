    "DocxSnapshotRecord": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "type": "string"
        },
        "document": {
          "$ref": "#/$defs/ReportArtifactRef"
        },
        "docx": {
          "$ref": "#/$defs/ReportArtifactRef"
        },
        "generator_version": {
          "type": "string"
