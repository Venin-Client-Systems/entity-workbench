          "type": "array"
        }
      },
      "required": [
        "totals",
        "balances",
        "accepted",
        "pending",
        "rejected",
        "deferred"
      ],
      "type": "object"
    },
    "CurrencyTotal": {
      "additionalProperties": false,
      "properties": {
        "credits": {
          "type": "string"
