        "deferred": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "pending": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "rejected": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "totals": {
          "items": {
            "$ref": "#/$defs/CurrencyTotal"
