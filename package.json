{
  "name": "entity-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --config ui/vite.config.ts",
    "build": "tsc --noEmit -p ui/tsconfig.json && vite build --config ui/vite.config.ts",
    "desktop": "cd desktop && tauri dev",
    "desktop:build": "cd desktop && tauri build --no-bundle",
    "test:ui": "playwright test",
    "check": "npm run build && cargo test -p workbench-core && python3 scripts/release_gate.py",
    "pretest:ui": "cargo build -p workbench-core --bin ew-dev --locked"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "cytoscape": "3.34.3",
    "echarts": "6.1.0",
    "maplibre-gl": "6.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.11.5",
    "@types/cytoscape": "^3.31.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
