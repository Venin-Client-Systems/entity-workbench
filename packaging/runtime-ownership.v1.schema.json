{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Entity Workbench reviewed runtime ownership plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target", "ocr_languages", "regions", "components"],
  "properties": {
    "schema_version": {"const": 1},
    "target": {"enum": ["windows-x86_64", "macos-aarch64", "macos-x86_64"]},
    "ocr_languages": {"$ref": "#/$defs/identifiers"},
    "regions": {"$ref": "#/$defs/identifiers"},
    "components": {
      "type": "array",
      "maxItems": 2100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "paths"],
        "properties": {
          "id": {"type": "string", "maxLength": 80},
          "version": {"type": "string", "pattern": "^[0-9][A-Za-z0-9._+\\-]{0,127}$"},
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100000,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 1024},
            "description": "Literal portable bundle-relative file/directory names; no glob, root, traversal, missing or empty directory selectors. The producer additionally checks total references, ownership, target policy and collisions."
          }
        }
      }
    }
  },
  "$defs": {
    "identifiers": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"}
    }
  }
}
